{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'nothing to install'",
  "buildCommand": "echo 'static site, nothing to build'",
  "outputDirectory": "docs",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/brother/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    },
    {
      "source": "/brother/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    },
    {
      "source": "/calendar/(.*)",
      "headers": [{ "key": "Content-Type", "value": "text/calendar; charset=utf-8" }]
    },
    {
      "source": "/brother/calendar/(.*)",
      "headers": [{ "key": "Content-Type", "value": "text/calendar; charset=utf-8" }]
    }
  ],
  "redirects": [
    { "source": "/brother", "destination": "/brother/", "permanent": false }
  ]
}
